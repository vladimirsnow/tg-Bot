# Токен от @BotFather
TELEGRAM_BOT_TOKEN=

# Укажи @юзернейм_бота или своё ключевое слово. Пусто = реальный @юзернейм бота.
BOT_TRIGGER=

# ID разрешённых групп через запятую. Узнать ID можно командой /chatid.
# Пока пусто, в группах доступна только команда /chatid для настройки.
ALLOWED_CHAT_IDS=

# Telegram ID единственного пользователя с доступом к боту в личке.
# При пустом поле /start в личке выводит ID в журнал сервера без ответа в Telegram.
OWNER_USER_ID=

# Необязательно. Путь к файлу cookies в формате Netscape на сервере.
INSTAGRAM_COOKIES_FILE=
YOUTUBE_COOKIES_FILE=
