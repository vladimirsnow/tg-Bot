{
  "manifest_version": 2,
  "name": "Local YouTube Cookie Export",
  "version": "1.0.0",
  "browser_specific_settings": {"gecko": {"id": "cookiebridge@tg-bot.local"}},
  "permissions": ["cookies", "https://youtube.com/*", "https://*.youtube.com/*", "nativeMessaging", "geckoViewAddons"],
  "background": {"scripts": ["background.js"]}
}
